params {
    ref              = 's3://joseph-dragen-test/references/v11/hg19-alt_masked.cnv.hla.methyl_cg.methylated_combined.rna-11-r5.0-1.tar.gz'
    normal_fastq_list= ''
    normal_RGSM      = ''
    normal_RGID      = ''
    tumor_fastq_list = ''
    tumor_RGSM       = ''
    tumor_RGID       = ''
    prefix           = ''
    noise_file       = ''
    output_dir       = 'results'
    intermediate_dir = 'tmp'
    dragen_container = "public.ecr.aws/docker/library/oraclelinux:8"
    lic              = ""
}

process {
  cpus = 20
  memory = 200.GB
  container = "${params.dragen_container}"
  containerOptions = '-v /opt/edico/bin:/opt/edico/bin'
}

aws {
    batch {
        volumes = '/opt/edico/bin:/opt/edico/bin'
    }
}